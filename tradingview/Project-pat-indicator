if newSixPM
    // Reset TF2 box history so OB pattern counting starts fresh every session
    array.clear(tf2History)
    array.clear(drawnOBKeys)

    // Hard failsafe: snap any OBs that survived past 4 PM and archive them.
    // This ensures OBs NEVER expand into a new session regardless of 4 PM detection.
    if showOBInput and array.size(activeOBs) > 0
        for ob in activeOBs
            ob.bx.set_right(bar_index)
            array.push(archivedOBs, ob.bx)
        array.clear(activeOBs)
        while array.size(archivedOBs) > obLookbackInput
            box.delete(array.shift(archivedOBs))

if newSixPM and showFibInput
    if array.size(openFibSets) > 0
        for fs in openFibSets
            deleteFibSet(fs)
        array.clear(openFibSets)

    if array.size(fibSetsArr) > 0
        for fs in fibSetsArr
            deleteFibSet(fs)
        array.clear(fibSetsArr)

    int nPending = array.size(pendingFibTops)
    if nPending > 0
        for i = 0 to nPending - 1
            float ft = array.get(pendingFibTops, i)
            float fb = array.get(pendingFibBots, i)
            FibSet fs = drawFibSet(bar_index, bar_index + 1, ft, fb)
            array.push(openFibSets, fs)
        array.clear(pendingFibTops)
        array.clear(pendingFibBots)
        array.clear(pendingFibBars)

// ═══════════════════════════════════════════════════════════════
// AT 4 PM — snap fib lines; expire OB sessions
// ═══════════════════════════════════════════════════════════════
if new4PM and showFibInput
    int nOpen = array.size(openFibSets)
    if nOpen > 0
        for i = 0 to nOpen - 1
            FibSet fs = array.get(openFibSets, i)
            if not fibExtendInput
                snapFibRight(fs, bar_index)
            array.push(fibSetsArr, fs)
        array.clear(openFibSets)
    while array.size(fibSetsArr) > fibLookbackInput
        FibSet old = array.shift(fibSetsArr)
        deleteFibSet(old)

// At 4 PM, snap all active OBs to the session close, archive them, enforce lookback cap.
if new4PM and showOBInput and array.size(activeOBs) > 0
    for ob in activeOBs
        ob.bx.set_right(bar_index)
        array.push(archivedOBs, ob.bx)
    array.clear(activeOBs)
    // Trim archived OBs beyond lookback — delete the oldest boxes
    while array.size(archivedOBs) > obLookbackInput
        box old = array.shift(archivedOBs)
        box.delete(old)

