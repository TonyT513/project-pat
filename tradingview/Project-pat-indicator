// ═══════════════════════════════════════════════════════════════
// TF1: ON EACH NEW PERIOD — draw closed box, level lines, queue fibs
// ═══════════════════════════════════════════════════════════════
if isNewPeriod
    prevBarIndex := bar_index

    // ── Draw the closed HTF box ──────────────────────────────
    box htBar = box.new(na, na, na, na)
    htBar.setBox(false, left, right, top, bottom, diff,
         upBodyColorInput, dnBodyColorInput, upBorderColorInput, dnBorderColorInput)

    if calcTypeInput == CalcType.ohlc
        box htBody = box.new(na, na, na, na)
        htBody.setBox(false, left, right, bar.o, bar.c, diff,
             upBodyColorInput, dnBodyColorInput, upBorderColorInput, dnBorderColorInput)

    // ── DOW label pinned to top of the CLOSED box (fixed) ───
    if showDowLabelsInput
        string closedTxt = dowLabelText(prevBoxOpenDOW)
        if str.length(closedTxt) > 0
            int    lx  = dowResolveX(dowHPosInput, left, right)
            float  ly  = dowVPosInput == "Below" ? bottom : top
            string lst = dowResolveStyle(dowVPosInput)
            label.new(lx, ly, closedTxt,
                 style     = lst,
                 color     = dowLabelBgInput,
                 textcolor = dowLabelColorInput,
                 size      = size.small)

    // ── Create live DOW label for the NEW opening box ────────
    // Delete the previous live label first, then create a fresh one.
    if not na(rtDowLabel)
        label.delete(rtDowLabel)
        rtDowLabel := na
    prevBoxOpenDOW := dayofweek   // record DOW for the box now opening
    if showDowLabelsInput
        string newTxt = dowLabelText(dayofweek)
        if str.length(newTxt) > 0
            float  ly2  = dowVPosInput == "Below" ? open : open
            string lst2 = dowResolveStyle(dowVPosInput)
            rtDowLabel := label.new(bar_index, open, newTxt,
                 style     = lst2,
                 color     = dowLabelBgInput,
                 textcolor = dowLabelColorInput,
                 size      = size.small)

    // ── Draw top/bottom level lines ──────────────────────────
    if array.size(levelLinesArr) > 0
        for ll in levelLinesArr
            if not na(ll.topLine)
                ll.topLine.set_x2(bar_index)
            if not na(ll.botLine)
                ll.botLine.set_x2(bar_index)

    line newTop = na
    line newBot = na
    string lstyle = lineStyleResolved(lineStyleInput)

    if showTopLineInput and not na(top)
        newTop := line.new(left, top, bar_index, top,
             color = topLineColorInput, width = lineWidthInput, style = lstyle, extend = extend.right)

    if showBotLineInput and not na(bottom)
        newBot := line.new(left, bottom, bar_index, bottom,
             color = botLineColorInput, width = lineWidthInput, style = lstyle, extend = extend.right)

    array.push(levelLinesArr, LevelLines.new(newTop, newBot))
    if array.size(levelLinesArr) > lookbackInput
        LevelLines oldest = array.shift(levelLinesArr)
        if not na(oldest.topLine)
            line.delete(oldest.topLine)
        if not na(oldest.botLine)
            line.delete(oldest.botLine)

    // ── Queue this closed box's fib data for next 6 PM render ─
    if showFibInput and not na(top) and not na(bottom)
        array.push(pendingFibTops, top)
        array.push(pendingFibBots, bottom)
        array.push(pendingFibBars, bar_index)
        while array.size(pendingFibTops) > fibLookbackInput
            array.shift(pendingFibTops)
            array.shift(pendingFibBots)
            array.shift(pendingFibBars)

    // ── Store closed box levels for crossover alert ───────────
    prevBoxTop := top
    prevBoxBot := bottom

// ═══════════════════════════════════════════════════════════════
// TF2: ON EACH NEW PERIOD — draw closed boxes + detect order blocks
// ═══════════════════════════════════════════════════════════════
if isNewPeriod2
    prevBarIndex2 := bar_index
    if showTF2Input
        box htBar2 = box.new(na, na, na, na)
        htBar2.setBox(false, left2, right2, top2, bottom2, diff2,
             tf2UpBodyColor, tf2DnBodyColor, tf2UpBorderColor, tf2DnBorderColor)
        if calcTypeInput == CalcType.ohlc
            box htBody2 = box.new(na, na, na, na)
            htBody2.setBox(false, left2, right2, bar2.o, bar2.c, diff2,
                 tf2UpBodyColor, tf2DnBodyColor, tf2UpBorderColor, tf2DnBorderColor)

    // ── Store closed TF2 box in history (cap at 12) ──────────
    bool tf2IsUp2 = diff2 >= 0
    array.push(tf2History, TF2BoxInfo.new(tf2IsUp2, top2, bottom2, left2, right2))
    if array.size(tf2History) > 12
        array.shift(tf2History)

    // ── Order Block Detection ────────────────────────────────
    // Pattern: [≥2 same dir] → [1–2 opposite dir = OB] → [≥2 same dir confirmed]
    // The OB candles are the 1–2 opposite-direction boxes in the middle.
    if showOBInput and array.size(tf2History) >= 5
        int  n          = array.size(tf2History)

        // --- Check BEARISH OB (green OB inside red context) ---
        // Step 1: count trailing reds (confirmation)
        int trailRed = 0
        for i = n - 1 to 0
            if not array.get(tf2History, i).isUp
                trailRed += 1
            else
                break
        // Step 2: count green OB candles just before trailing reds
        int obGreenCount = 0
        if trailRed >= 2
            int obStart = n - 1 - trailRed
            for i = obStart to 0
                if array.get(tf2History, i).isUp
                    obGreenCount += 1
                else
                    break
        // Step 3: count leading reds before the OB greens
        int leadRed = 0
        if trailRed >= 2 and obGreenCount >= 1 and obGreenCount <= 2
            int leadStart = n - 1 - trailRed - obGreenCount
            for i = leadStart to 0
                if not array.get(tf2History, i).isUp
                    leadRed += 1
                else
                    break
        // Step 4: draw if pattern confirmed and not already drawn
        if trailRed >= 2 and obGreenCount >= 1 and obGreenCount <= 2 and leadRed >= 2
            int obIdxFirst = n - 1 - trailRed - obGreenCount + 1
            int obIdxLast  = n - 1 - trailRed
            TF2BoxInfo firstOB = array.get(tf2History, obIdxFirst)
            TF2BoxInfo lastOB  = array.get(tf2History, obIdxLast)
            int obLeftBar = firstOB.leftBar
            if array.indexof(drawnOBKeys, obLeftBar) < 0
                float obHi = firstOB.hi
                float obLo = firstOB.lo
                for k = obIdxFirst to obIdxLast
                    TF2BoxInfo b = array.get(tf2History, k)
                    obHi := math.max(obHi, b.hi)
                    obLo := math.min(obLo, b.lo)
                // Enforce total cap (active + archived) before drawing
                while array.size(activeOBs) + array.size(archivedOBs) >= obLookbackInput
                    if array.size(archivedOBs) > 0
                        box.delete(array.shift(archivedOBs))
                    else if array.size(activeOBs) > 0
                        OBEntry oldest = array.shift(activeOBs)
                        box.delete(oldest.bx)
                    else
                        break
                box newOB = box.new(obLeftBar, obHi, bar_index, obLo,
                     bgcolor = bearOBColor, border_color = bearOBBorder, border_width = obBorderWidth)
                array.push(activeOBs, OBEntry.new(newOB))
                lastOBBar := bar_index
                array.push(drawnOBKeys, obLeftBar)
                if array.size(drawnOBKeys) > 50
                    array.shift(drawnOBKeys)

        // --- Check BULLISH OB (red OB inside green context) ---
        int trailGrn = 0
        for i = n - 1 to 0
            if array.get(tf2History, i).isUp
                trailGrn += 1
            else
                break
        int obRedCount = 0
        if trailGrn >= 2
            int obStart2 = n - 1 - trailGrn
            for i = obStart2 to 0
                if not array.get(tf2History, i).isUp
                    obRedCount += 1
                else
                    break
        int leadGrn = 0
        if trailGrn >= 2 and obRedCount >= 1 and obRedCount <= 2
            int leadStart2 = n - 1 - trailGrn - obRedCount
            for i = leadStart2 to 0
                if array.get(tf2History, i).isUp
                    leadGrn += 1
                else
                    break
        if trailGrn >= 2 and obRedCount >= 1 and obRedCount <= 2 and leadGrn >= 2
            int obIdxFirst2 = n - 1 - trailGrn - obRedCount + 1
            int obIdxLast2  = n - 1 - trailGrn
            TF2BoxInfo firstOB2 = array.get(tf2History, obIdxFirst2)
            TF2BoxInfo lastOB2  = array.get(tf2History, obIdxLast2)
            int obLeftBar2 = firstOB2.leftBar
            if array.indexof(drawnOBKeys, obLeftBar2) < 0
                float obHi2 = firstOB2.hi
                float obLo2 = firstOB2.lo
                for k2 = obIdxFirst2 to obIdxLast2
                    TF2BoxInfo b2 = array.get(tf2History, k2)
                    obHi2 := math.max(obHi2, b2.hi)
                    obLo2 := math.min(obLo2, b2.lo)
                // Enforce total cap (active + archived) before drawing
                while array.size(activeOBs) + array.size(archivedOBs) >= obLookbackInput
                    if array.size(archivedOBs) > 0
                        box.delete(array.shift(archivedOBs))
                    else if array.size(activeOBs) > 0
                        OBEntry oldest = array.shift(activeOBs)
                        box.delete(oldest.bx)
                    else
                        break
                box newOB2 = box.new(obLeftBar2, obHi2, bar_index, obLo2,
                     bgcolor = bullOBColor, border_color = bullOBBorder, border_width = obBorderWidth)
                array.push(activeOBs, OBEntry.new(newOB2))
                lastOBBar := bar_index
                array.push(drawnOBKeys, obLeftBar2)
                if array.size(drawnOBKeys) > 50
                    array.shift(drawnOBKeys)

