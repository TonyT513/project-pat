// ── Alert 1: New Order Block formed ─────────────────────────
// Fires on the bar where a new OB was detected and drawn.
bool obFormedAlert = showOBInput and (bar_index == lastOBBar)

alertcondition(obFormedAlert,
     title   = "Order Block Formed",
     message = "🟦 {{ticker}} ({{interval}}) — New Order Block detected at {{close}}")

// ── Alert 2: Opens inside OB, closes outside (rejection) ────
// Price opened inside an active OB zone but closed beyond it —
// signals the OB was tested and rejected, or that a clean break occurred.
bool obRejectionAlert = false
if showOBInput and array.size(activeOBs) > 0
    for ob in activeOBs
        float obHiLevel = ob.bx.get_top()
        float obLoLevel = ob.bx.get_bottom()
        bool  openInside  = open  >= obLoLevel and open  <= obHiLevel
        bool  closeOutside = close < obLoLevel or  close > obHiLevel
        if openInside and closeOutside
            obRejectionAlert := true

alertcondition(obRejectionAlert,
     title   = "OB Open Inside / Close Outside",
     message = "⚠️ {{ticker}} ({{interval}}) — Candle opened inside Order Block but closed outside at {{close}}")

// ── Alert 3: Price crosses previous TF1 box High or Low ─────
// Fires when chart close crosses above the prior daily box high
// or crosses below the prior daily box low.
bool crossAbovePrevHigh = not na(prevBoxTop) and close > prevBoxTop and close[1] <= prevBoxTop
bool crossBelowPrevLow  = not na(prevBoxBot) and close < prevBoxBot and close[1] >= prevBoxBot
bool prevBoxCrossAlert  = crossAbovePrevHigh or crossBelowPrevLow

alertcondition(prevBoxCrossAlert,
     title   = "Price Crossed Previous Box High/Low",
     message = "🚨 {{ticker}} ({{interval}}) — Price crossed previous daily box high/low at {{close}}")

// ── Alert 4: RT Fib 0.500 Touch (existing) ──────────────────
float rt050Level = na
if not isNewPeriod and not na(bar0.h) and not na(bar0.l) and bar0.h != bar0.l
    rt050Level := bar0.l + 0.500 * (bar0.h - bar0.l)

bool touches050 = showRtFibInput
     and not isNewPeriod
     and not na(rt050Level)
     and low  <= rt050Level
     and high >= rt050Level

alertcondition(touches050,
     title   = "RT Fib 0.500 Touch",
     message = "⚡ {{ticker}} ({{interval}}) — price touched the Real-time Fib 0.500 level at {{close}}")
