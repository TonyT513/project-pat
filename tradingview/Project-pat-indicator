//@function Resolves Pine line style from user string input.
lineStyleResolved(styleStr) =>
    switch styleStr
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        =>          line.style_solid

//@function Sets the position and colors of a box, or hides it if cond is true.
method setBox(box bx, cond, left, right, top, bottom, diff, upBodyColor, dnBodyColor, upBorderColor, dnBorderColor) =>
    color bodyColor   = diff < 0 ? dnBodyColor   : upBodyColor
    color borderColor = diff < 0 ? dnBorderColor : upBorderColor
    if cond
        bx.set_bgcolor(na)
        bx.set_border_color(na)
    else
        bx.set_left(left)
        bx.set_right(right)
        bx.set_top(top)
        bx.set_bottom(bottom)
        bx.set_bgcolor(bodyColor)
        bx.set_border_color(borderColor)

//@function Returns auto-selected higher timeframe string.
selectAutoTimeframe() =>
    int secondsInTF = timeframe.in_seconds()
    switch
        timeframe.isseconds   => "120"
        secondsInTF < 86400   => "1440"
        secondsInTF < 604800  => "1W"
        secondsInTF < 2628003 => "1M"
        secondsInTF < 7884009 => "3M"
        => "12M"

//@function Adjusts "1D" to "1440" during extended sessions.
selectTimeframeFromInput(tf) =>
    syminfo.session == session.extended and tf == "1D" ? "1440" : tf

//@function Creates an OHLC object from the current bar at the given offset.
makeOHLC(offset = 0) =>
    OHLC.new(open[offset], high[offset], low[offset], close[offset], close[offset + 1])

//@function Calculates Heikin Ashi values from OHLC + previous HA values.
haFrom(o, h, l, c, prevHO, prevHC) =>
    float haC = (o + h + l + c) / 4
    float haO = na(prevHO) or na(prevHC) ? (o + c) / 2 : (prevHO + prevHC) / 2
    float haH = math.max(h, haO, haC)
    float haL = math.min(l, haO, haC)
    [haO, haH, haL, haC]

//@function Builds HTF OHLC using chart-based aggregation with optional HA.
chartOHLC(tf, useHA) =>
    var float htfOpen   = na
    var float htfHigh   = na
    var float htfLow    = na
    var float prevClose = na
    var float haClose   = na
    var float haOpen    = na
    var float prevHaC   = na
    var float prevHaO   = na
    if timeframe.change(tf)
        htfOpen   := open
        htfHigh   := high
        htfLow    := low
        prevClose := close[1]
        prevHaO   := haOpen
        prevHaC   := haClose
    htfHigh := math.max(high, htfHigh)
    htfLow  := math.min(low,  htfLow)
    if useHA
        [haO, haH, haL, haC] = haFrom(htfOpen, htfHigh, htfLow, close, prevHaO, prevHaC)
        haOpen  := haO
        haClose := haC
        OHLC.new(haO, haH, haL, haC, prevHaC)
    else
        OHLC.new(htfOpen, htfHigh, htfLow, close, prevClose)

//@function Returns the price at a given Fibonacci ratio between top and bottom.
// Ratio 0 = top (highest price), ratio 1 = bottom (lowest price).
fibPrice(topP, botP, ratio) =>
    topP - ratio * (topP - botP)

//@function Resolves label style from vertical + horizontal position inputs.
dowResolveStyle(string vPos) =>
    switch vPos
        "Below" => label.style_label_up
        =>         label.style_label_down   // "Above" — arrow points down from label into box

//@function Resolves label x position from horizontal position input.
dowResolveX(string hPos, int leftBar, int rightBar) =>
    switch hPos
        "Middle" => math.round((leftBar + rightBar) / 2)
        "Right"  => rightBar
        =>          leftBar   // "Left"

//@function Returns the day-of-week label text for a given dayofweek value.
// Uses dayofweek of the bar that OPENS the new box (evening before the named session).
// Futures boxes open at 6 PM — one calendar day before the session they represent:
//   Sunday  6 PM → Monday    box → "Liquidity Sweep"
//   Monday  6 PM → Tuesday   box → "Order Block Rejects"
//   Tuesday 6 PM → Wednesday box → "Order Block Rejects"
//   Wednesday 6 PM → Thursday box → "Gap Fill"
//   Thursday 6 PM → Friday   box → "TGIF"
dowLabelText(int openDOW) =>
    switch openDOW
        dayofweek.sunday    => "📌 Liquidity Sweep"
        dayofweek.monday    => "🔁 Order Block Rejects"
        dayofweek.tuesday   => "🔁 Order Block Rejects"
        dayofweek.wednesday => "⚡ Thursday big swings"
        dayofweek.thursday  => "🎉 Friday, Use the fibonacci"
        => ""

